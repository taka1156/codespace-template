{
  "$schema": "https://raw.githubusercontent.com/taka1156/codespacegen/master/codespacegen.schema.json",
  "common": {
    "locale": {
      "lang": "ja_JP.UTF-8",
      "language": "ja_JP:ja",
      "lcAll": "ja_JP.UTF-8"
    },
    "timezone": "Asia/Tokyo",
    "vscodeExtensions": [
      "MS-CEINTL.vscode-language-pack-ja",
      "streetsidesoftware.code-spell-checker",
      "usernamehw.errorlens"
    ]
  },
  "langs": [
    {
      "profileName": "go",
      "image": "golang:1.27-alpine",
      "vscodeExtensions": [
        "golang.GO"
      ]
    },
    {
      "profileName": "rust",
      "image": "rust:1.98-alpine",
      "vscodeExtensions": [
        "Zerotaskx.rust-extension-pack"
      ]
    },
    {
      "profileName": "zig",
      "image": "zig:0.13.0-alpine",
      "vscodeExtensions": [
        "ziglang.vscode-zig"
      ]
    },
    {
      "profileName": "moonbit",
      "image": "ubuntu:26.10",
      "vscodeExtensions": [
        "moonbit.moonbit-lang"
      ],
      "runCommand": "curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash"
    },
    {
      "profileName": "python",
      "image": "python:3.14-alpine",
      "vscodeExtensions": [
        "ms-python.python"
      ]
    },
    {
      "profileName": "node:biome",
      "image": "node:26-alpine",
      "vscodeExtensions": [
        "biomejs.biome"
      ]
    },
    {
      "profileName": "node:eslint",
      "image": "node:26-alpine",
      "vscodeExtensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode"
      ]
    },
    {
      "profileName": "node:react",
      "image": "node:26-alpine",
      "vscodeExtensions": [
        "jawandarajbir.react-vscode-extension-pack",
        "dbaeumer.vscode-eslint",
        "stylelint.vscode-stylelint",
        "esbenp.prettier-vscode"
      ]
    },
    {
      "profileName": "node:astro",
      "image": "node:26-alpine",
      "vscodeExtensions": [
        "astro-build.astro-vscode",
        "biomejs.biome",
        "formulahendry.auto-rename-tag",
        "yoavbls.pretty-ts-errors",
        "capsaskey.vscode-vanilla-extract"
      ],
      "runCommand": "corepack enable \u0026\u0026 corepack prepare pnpm@latest --activate"
    },
    {
      "profileName": "gcc",
      "image": "ubuntu:26.10",
      "vscodeExtensions": [
        "ms-vscode.cpptools"
      ],
      "linuxPackages": [
        "gcc",
        "make",
        "binutils",
        "libc6-dev"
      ]
    },
    {
      "profileName": "node:zenn",
      "image": "node:26-alpine",
      "vscodeExtensions": [
        "zenn.zenn-preview"
      ],
      "runCommand": "yarn global add zenn-cli textlint markdownlint"
    }
  ]
}
