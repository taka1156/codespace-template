{
  "$schema": "https://raw.githubusercontent.com/taka1156/codespacegen/master/codespacegen.schema.json",
  "common": {
    "locale": {
      "lang": "ja_JP.UTF-8",
      "language": "ja_JP:ja",
      "lcAll": "ja_JP.UTF-8"
    },
    "timezone": "Asia/Tokyo",
    "vscodeExtensions": [
      "MS-CEINTL.vscode-language-pack-ja",
      "streetsidesoftware.code-spell-checker",
      "usernamehw.errorlens"
    ]
  },
  "langs": [
    {
      "profileName": "go",
      "image": "golang:1.27",
      "vscodeExtensions": [
        "golang.GO"
      ]
    },
    {
      "profileName": "rust",
      "image": "rust:1.99-slim",
      "vscodeExtensions": [
        "Zerotaskx.rust-extension-pack"
      ]
    },
    {
      "profileName": "moonbit",
      "image": "ubuntu:26.10",
      "vscodeExtensions": [
        "moonbit.moonbit-lang"
      ],
      "runCommand": "curl -fsSL https://cli.moonbitlang.com/install/unix.sh | bash"
    },
    {
      "profileName": "vite+",
      "image": "ubuntu:26.10",
      "vscodeExtensions": [
        "oxc.oxc-vscode"
      ],
      "runCommand": "curl -fsSL https://vite.plus | bash || { find / -path '*vite-plus*' -name upgrade.log -exec cat {} + 2\u003e/dev/null; exit 1; }; BIN=\"$(ls -d \"$HOME/.vite-plus/bin\" \"$HOME/.local/share/vite-plus/bin\" 2\u003e/dev/null | head -n1)\"; [ -n \"$BIN\" ] || { echo 'vp bin dir not found'; exit 1; }; for f in \"$BIN\"/*; do ln -sf \"$f\" \"/usr/local/bin/$(basename \"$f\")\"; done; vp --version",
      "linuxPackages": [
        "libatomic1"
      ]
    },
    {
      "profileName": "node:biome",
      "image": "node:26-slim",
      "vscodeExtensions": [
        "biomejs.biome"
      ]
    },
    {
      "profileName": "node:react",
      "image": "node:26-slim",
      "vscodeExtensions": [
        "jawandarajbir.react-vscode-extension-pack",
        "dbaeumer.vscode-eslint",
        "stylelint.vscode-stylelint",
        "esbenp.prettier-vscode"
      ]
    },
    {
      "profileName": "node:astro",
      "image": "node:26-slim",
      "vscodeExtensions": [
        "astro-build.astro-vscode",
        "biomejs.biome",
        "formulahendry.auto-rename-tag",
        "yoavbls.pretty-ts-errors",
        "capsaskey.vscode-vanilla-extract"
      ],
      "runCommand": "corepack enable \u0026\u0026 corepack prepare pnpm@latest --activate"
    },
    {
      "profileName": "gcc",
      "image": "ubuntu:26.10",
      "vscodeExtensions": [
        "ms-vscode.cpptools"
      ],
      "linuxPackages": [
        "gcc",
        "make",
        "binutils",
        "libc6-dev"
      ]
    }
  ]
}
